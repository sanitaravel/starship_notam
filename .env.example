# Starship NOTAM bot configuration.
#
# Copy this file to .env in the project root and fill in the required values:
#     cp .env.example .env
# .env is git-ignored; never commit real tokens. Values in .env override
# variables already set in the environment. Optional settings below are
# commented out and show their default value.

# ---------------------------------------------------------------------------
# Destinations (set Telegram, Discord, or both)
# ---------------------------------------------------------------------------

# Telegram: set both values, or leave both empty to skip Telegram.
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Channel the bot posts to: numeric id (-100...) or @username.
# The bot must be an admin of the channel with permission to post.
TELEGRAM_CHANNEL_ID=

# Discord: webhook URL of the channel to post to (Channel settings ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL).
# It contains a secret token; leave empty to skip Discord.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Schedule
# ---------------------------------------------------------------------------

# Wake-ups per hour, aligned to the clock (12 = every 5 minutes). Each source
# runs on its own interval below, checked at every wake-up.
# RUNS_PER_HOUR=12

# Poll interval per source in minutes (integer >= 1; default shown).
# A source runs on the first wake-up at which its interval (minus half the
# wake-up interval) has elapsed, so intervals are effectively rounded to a
# multiple of the wake-up interval; a value up to half of it runs on every wake-up.
# NOTAMS_INTERVAL_MINUTES=10
# FAA_ADVISORIES_INTERVAL_MINUTES=5
# FCC_ELS_INTERVAL_MINUTES=30
# FAA_DRS_INTERVAL_MINUTES=60
# COMPASS_INTERVAL_MINUTES=30
# FEDERAL_REGISTER_INTERVAL_MINUTES=30
# REGULATIONS_GOV_INTERVAL_MINUTES=30
# SEC_EDGAR_INTERVAL_MINUTES=10
# USCG_BNM_INTERVAL_MINUTES=15
# STARBASE_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Database backend. Set DATABASE_URL to use PostgreSQL (needs the "postgres"
# extra: pip install -e ".[postgres]"); leave it unset to use SQLite.
# DATABASE_URL=postgresql://notam:secret@localhost:5432/notam

# SQLite database file, used when DATABASE_URL is unset (relative paths
# resolve from the working directory).
# Docker example: NOTAM_DB_PATH=/app/data/notams.db
# NOTAM_DB_PATH=notams.db

# Docker Compose only: the stack runs its own PostgreSQL and builds
# DATABASE_URL from these (DATABASE_URL and NOTAM_DB_PATH above are ignored
# there). The password is required; it goes into a URL, so use letters and
# digits only.
POSTGRES_PASSWORD=
# POSTGRES_USER=notam
# POSTGRES_DB=notam

# Log directory (default: logs/ in the project root).
# NOTAM_LOG_DIR=logs

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------

# api.data.gov key for Regulations.gov (free: https://open.gsa.gov/api/regulationsgov/).
# Leave empty to skip the Regulations.gov source.
REGULATIONS_GOV_API_KEY=

# User-Agent for SEC EDGAR (SpaceX filings). SEC blocks requests without a
# descriptive one naming a contact, e.g. "starship_notam bot admin@example.org".
# Leave empty to skip the SEC EDGAR source.
SEC_USER_AGENT=

# FAA DRS document id of the tracked Starship launch license.
# FAA_LICENSE_DOC_ID=DRSDOCID173891218620231102140506.0001
