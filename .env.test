# Settings for tests and manual checks; never real credentials or data.
#
# pytest loads this file instead of .env (see tests/conftest.py). For a
# manual run, select it with NOTAM_ENV_FILE, e.g.:
#     NOTAM_ENV_FILE=.env.test NOTAM_LOG_DIR=logs/test python prefill_federal_register.py
# Values here override the environment, like .env does.

# Placeholders: nothing in the test suite talks to Telegram.
TELEGRAM_BOT_TOKEN=test-token
TELEGRAM_CHANNEL_ID=@test-channel

# A separate SQLite file (git-ignored via *.db), never the bot's notams.db.
# Delete it to start from an empty database.
NOTAM_DB_PATH=test_notams.db

# NOTAM_LOG_DIR is deliberately not set: pytest points it at a temporary
# folder, and a value here would override that. For a manual run, pass it on
# the command line to keep the bot's logs/notam.log intact.

RUN_MODE=standalone
